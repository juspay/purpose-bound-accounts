{
    "version": "1.0",
    "sources": ["model"],
    "outputDirectory": "sdk/output",
    "maven": {
        "repositories": [
            {
                "url": "https://repo1.maven.org/maven2"
            },
            {
                "url": "https://sandbox.assets.juspay.in/smithy/m2"
            }
        ],
        "dependencies": [
            "software.amazon.smithy:smithy-model:1.55.0",
            "software.amazon.smithy:smithy-utils:1.55.0",
            "software.amazon.smithy:smithy-codegen-core:1.55.0",
            "software.amazon.smithy:smithy-aws-traits:1.55.0",
            "software.amazon.smithy:smithy-validation-model:1.55.0",
            "software.amazon.smithy.rust.codegen:codegen-client:0.1.0",
            "software.amazon.smithy:smithy-openapi:1.55.0",
            "software.amazon.smithy:smithy-aws-apigateway-openapi:1.55.0"
        ]
    },
    "plugins": {
        "openapi": {
            "service": "com.ppi.pba#PurposeBoundAccountService",
            "protocol": "aws.protocols#restJson1",
            "jsonContentType": "application/json"
        },
        "rust-client-codegen": {
            "runtimeConfig": {
                "version": "1.2.5"
            },
            "codegen": {
                "addMessageToErrors": true,
                "renameErrors": true,
                "enableNewSmithyRuntime": "orchestrator"
            },
            "service": "com.ppi.pba#PurposeBoundAccountService",
            "module": "pba_client",
            "moduleVersion": "0.1.0",
            "minimumSupportedRustVersion": "1.82.0",
            "moduleDescription": "Rust SDK for the Purpose-Bound Account Service",
            "moduleAuthors": [
                "pba-service"
            ]
        }
    }
}
