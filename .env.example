DB_HOST=/tmp
DB_PORT=5432
DB_NAME=pba_service
# DB_USER — omit for local trust auth (defaults to OS user); set explicitly for TCP/password auth
# DB_PASSWORD — only needed when DB_USER is set; supports encrypted values via SECRETS_PROVIDER
DB_PASSWORD=
TIGERBEETLE_ADDRESSES=3000
TIGERBEETLE_CLUSTER_ID=0
RUST_LOG=pba_service=debug,tower_http=info
HOST=0.0.0.0
PORT=3030
PG_DATA=.pg_data
# Auth is disabled for local dev. Keycloak is disabled by default in
# process-compose.yml; set this to true (and enable Keycloak) to test OIDC login.
AUTH_ENABLED=false
